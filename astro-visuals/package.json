{
  "name": "galactic-transit",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Galactic Transit — the sources the single-file galactic-transit.html is built from.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "npm run pin && playwright test --project=baseline",
    "e2e": "playwright test --project=boot --project=parity",
    "verify": "npm run check && npm run test && npm run build && npm run e2e",
    "pin": "node scripts/pin.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "ts-blank-space": "^0.9.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
