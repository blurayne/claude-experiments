# The build toolchain's own droppings. `galactic-transit.html` is generated from `src/`
# and IS committed — it is what GitHub Pages serves — but nothing else here is.
node_modules/
.vite/

# Playwright's output. There are no stored screenshot baselines: the gate photographs both
# builds in the same run, so there is nothing to keep and nothing to go stale.
test-results/
playwright-report/

# The pinned pre-refactor page, materialised from git by tests/harness/pin.ts — by
# Playwright's globalSetup for the e2e suites, and by vitest's for the unit tests.
baseline-page.html
