__pycache__/
*.pyc

# microbe-render: HEIC archival masters are large & Safari-only — keep local
renders/**/*.heic
renders/**/*.png

# microbe-render: intermediate generation frames — finals/*.avif is the kept copy
renders/**/*.attempts/

# Labelled overlays embed the full raster (1–3 MB each, ~280 MB total) and are
# NOT needed by viewer.html — it renders labels live from the geometry baked into
# viewer-data.json. Keep the repo lean by not committing the per-theme SVG/HTML.
renders/**/theme/**/*.svg
renders/**/theme/**/*.html

# Stray/accidental artifacts
renders/set/set/
renders/OVERVIEW (copy).md

# Scratch space used while rendering: draft prompt text handed to the image API,
# and PNG rasterisations of SVGs made only to look at them. The prompt that was
# actually used is recorded per microbe in <microbe>.prompts.json / .render.md,
# so none of this is the record of anything.
.prompt_tmp/
.svgcheck_tmp/
.tmp_preview/


# file:// preview fallback bundle: every coloring page inlined so a locally
# opened viewer.html can still show them (the browser refuses to fetch() a
# sibling file). ~4 MB, regenerated by build_viewer.py, and the deployed site
# never requests it — not worth a fresh blob in every commit.
coloring-data.js

# build_pdfbook.py: the scratch/debug HTML only. The PDFs themselves ARE committed
# -- GitHub Pages serves this folder verbatim, so the viewer's "Read the picture
# book" link 404s unless the file is in the repo, the same reason the render AVIFs
# are committed. They are ~21 MB each; regenerate with build_pdfbook.py and expect
# the pair to land in every commit that changes book content.
microbes-book-*.html
.tmp_build/

# Scratch dirs that render/verify agents create while checking their own work
# (zoom crops, anchor-check composites, edge-scan dumps). They are working notes,
# not artifacts — several hundred PNGs accumulated across one session.
.tmp_*/
.svgcheck_tmp/
.prompt_tmp/

# Working files from a content/refactor pass: cells_data.py backups taken before a
# scripted edit, and the JSON an authoring agent hands to the orchestrator before it
# is merged into cells_data.py. Both are transient by construction.
.cells_data.py.bak*
.new_content*.json
