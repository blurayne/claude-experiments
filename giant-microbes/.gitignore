# Rejected AI upscale attempts (~13 MB of output that failed the silhouette gate).
# The verdicts that matter are in ai_upscale_report.json, which IS committed.
images_ai/

# Product photos pulled from the catalog for being the shop's not-found
# placeholder. All 19 files are the same group shot; no reason to version them.
# Which items were affected is recorded as image_placeholder_removed in the catalog.
images_rejected/

# Staging area used by upgrade_images.py between download and processing.
images_upgrade/

# Image-search candidates staged by download_candidates.py for the visual
